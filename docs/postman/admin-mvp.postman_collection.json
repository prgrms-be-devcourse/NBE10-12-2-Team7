            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"NOPE\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/reports/{{reportId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "admin", "reports", "{{reportId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
