    },
    {
      "name": "05. Comments",
      "item": [
        {
          "name": "댓글 목록 조회 (삭제 포함)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/comments", "host": ["{{baseUrl}}"], "path": ["api", "admin", "comments"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "var list = pm.response.json().data;",
                  "pm.test('배열 응답', function () { pm.expect(list).to.be.an('array'); });",
                  "var alive = list.find(function (c) { return c.deletedAt === null; });",
                  "if (alive) {",
                  "  pm.collectionVariables.set('commentId', alive.commentId);",
                  "  console.log('삭제 안된 commentId 캡처:', alive.commentId);",
                  "} else {",
                  "  console.warn('삭제 가능한 댓글 없음 — 삭제 요청은 404 날 수 있음(시드 데이터 필요)');",
                  "}"
                ]
