{
  "info": {
    "name": "Dongne Market - Admin MVP",
    "_postman_id": "a1b2c3d4-0000-4000-8000-admin000mvp01",
    "description": "관리자(Admin) MVP 엔드포인트 검증 시나리오.\n\n## 사용법\n1. 백엔드 기동(MySQL + Spring Boot). 부팅 시 admin@dongnemarket.com / admin1234! 계정이 자동 시드된다.\n2. 이 컬렉션을 Postman에 import.\n3. 컬렉션 변수 baseUrl 확인(기본 http://localhost:8080).\n4. 'Collection Runner'로 위에서부터 순서대로 실행하거나, 각 요청을 수동 실행.\n   - '00. Auth > Admin 로그인'을 먼저 실행해야 adminToken이 채워진다(이후 요청은 컬렉션 Bearer 인증 자동 사용).\n   - 목록 조회 요청들이 실제 데이터에서 productId/memberId/reportId/commentId 변수를 자동 캡처한다.\n\n각 요청에는 상태코드/응답형태 검증 스크립트(pm.test)가 포함되어 있다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{adminToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "productId", "value": "1" },
    { "key": "memberId", "value": "1" },
    { "key": "reportId", "value": "1" },
    { "key": "commentId", "value": "1" }
  ],
  "item": [
    {
      "name": "00. Auth",
      "item": [
        {
          "name": "Admin 로그인 (토큰 발급)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@dongnemarket.com\",\n  \"password\": \"admin1234!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('accessToken 존재', function () { pm.expect(json.data.accessToken).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('adminToken', json.data.accessToken);",
                  "console.log('adminToken 저장 완료');"
                ]
              }
            }
          ]
        },
        {
          "name": "비인증 접근 → 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "admin", "dashboard"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('토큰 없으면 401', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01. Dashboard",
      "item": [
        {
          "name": "대시보드 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "admin", "dashboard"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "var d = pm.response.json().data;",
                  "pm.test('집계 필드 5종 존재', function () {",
                  "  pm.expect(d).to.have.property('totalMembers');",
                  "  pm.expect(d).to.have.property('totalProducts');",
                  "  pm.expect(d).to.have.property('totalReports');",
                  "  pm.expect(d).to.have.property('pendingReports');",
                  "  pm.expect(d).to.have.property('totalComments');",
                  "});",
                  "console.log('대시보드:', JSON.stringify(d));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Products",
      "item": [
        {
          "name": "상품 목록 조회 (숨김·삭제 포함)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/products", "host": ["{{baseUrl}}"], "path": ["api", "admin", "products"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "var list = pm.response.json().data;",
                  "pm.test('배열 응답', function () { pm.expect(list).to.be.an('array'); });",
                  "if (list.length > 0) {",
                  "  pm.collectionVariables.set('productId', list[0].productId);",
                  "  console.log('productId 캡처:', list[0].productId);",
                  "} else {",
                  "  console.warn('상품 데이터 없음 — 상세/숨김/삭제 요청은 시드 데이터 필요');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "상품 상세 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "products", "{{productId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "var d = pm.response.json().data;",
                  "pm.test('관리자 전용 필드(hidden, deletedAt, createdAt) 노출', function () {",
                  "  pm.expect(d).to.have.property('hidden');",
                  "  pm.expect(d).to.have.property('deletedAt');",
                  "  pm.expect(d).to.have.property('createdAt');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "상품 숨김 처리 (단방향)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/products/{{productId}}/hidden", "host": ["{{baseUrl}}"], "path": ["api", "admin", "products", "{{productId}}", "hidden"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('data 없는 성공(null)', function () { pm.expect(pm.response.json().data).to.equal(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "상품 소프트 삭제",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "products", "{{productId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('data null', function () { pm.expect(pm.response.json().data).to.equal(null); });",
                  "console.log('주의: 삭제 후에도 admin 목록에는 계속 보임(deletedAt 세팅만)');"
                ]
              }
            }
          ]
        },
        {
          "name": "상품 상세 - 없는 ID → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/products/99999999", "host": ["{{baseUrl}}"], "path": ["api", "admin", "products", "99999999"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', function () { pm.response.to.have.status(404); });",
                  "pm.test('error = PRODUCT_NOT_FOUND', function () { pm.expect(pm.response.json().error).to.eql('PRODUCT_NOT_FOUND'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03. Members",
      "item": [
        {
          "name": "회원 목록 조회 (상태 무관)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/members", "host": ["{{baseUrl}}"], "path": ["api", "admin", "members"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "var list = pm.response.json().data;",
                  "pm.test('배열 응답', function () { pm.expect(list).to.be.an('array'); });",
                  "var target = list.find(function (m) { return m.role !== 'ROLE_ADMIN'; });",
                  "if (target) {",
                  "  pm.collectionVariables.set('memberId', target.memberId);",
                  "  console.log('일반회원 memberId 캡처:', target.memberId);",
                  "} else {",
                  "  console.warn('일반 회원 없음 — 상태변경은 admin 대상이 됨(주의). 일반회원 시드 권장');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "회원 상세 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/admin/members/{{memberId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "members", "{{memberId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "var d = pm.response.json().data;",
                  "pm.test('email/role/status 노출, password 미노출', function () {",
                  "  pm.expect(d).to.have.property('email');",
                  "  pm.expect(d).to.have.property('role');",
                  "  pm.expect(d).to.have.property('status');",
                  "  pm.expect(d).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "회원 상태 변경 → SUSPENDED",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"SUSPENDED\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/members/{{memberId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "admin", "members", "{{memberId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('status = SUSPENDED 반영', function () { pm.expect(pm.response.json().data.status).to.eql('SUSPENDED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "회원 상태 변경 → ACTIVE (복구)",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/members/{{memberId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "admin", "members", "{{memberId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('status = ACTIVE 복구', function () { pm.expect(pm.response.json().data.status).to.eql('ACTIVE'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "회원 상태 변경 - 잘못된 값 → 400",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"NOT_A_STATUS\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/members/{{memberId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "admin", "members", "{{memberId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', function () { pm.response.to.have.status(400); });",
                  "pm.test('error = INVALID_MEMBER_STATUS', function () { pm.expect(pm.response.json().error).to.eql('INVALID_MEMBER_STATUS'); });"
                ]
              }
            }
          ]
        }
      ]
    },
