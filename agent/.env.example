# Ollama 연결 (로컬)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# 모델 옵션 (Java admin.ai에서 실측 검증된 값 계승 — agent/README.md 참고)
AGENT_TEMPERATURE=0.1
AGENT_NUM_PREDICT=512
AGENT_KEEP_ALIVE=30m

# FastAPI
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# 임베딩 · 벡터스토어
EMBED_MODEL=bge-m3
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=minsa_legal

# 인제스트 필터 LLM (클라우드, OpenAI 호환 · 기본 NVIDIA NIM)
FILTER_PROVIDER=nvidia_nim
FILTER_BASE_URL=https://integrate.api.nvidia.com/v1
FILTER_MODEL=qwen/qwen3-next-80b-a3b-instruct
FILTER_API_KEY=         # build.nvidia.com 키 — 커밋 금지
FILTER_TEMPERATURE=0
