# Ollama 연결 (로컬 — 임베딩 bge-m3 전용)
OLLAMA_BASE_URL=http://localhost:11434

# 생성 옵션 (NIM 생성에 사용)
AGENT_TEMPERATURE=0.1
AGENT_NUM_PREDICT=1024

# FastAPI
AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# 임베딩 · 벡터스토어
EMBED_MODEL=bge-m3
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=minsa_legal

# 생성 LLM (클라우드 NVIDIA NIM · OpenAI 호환)
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=qwen/qwen3-next-80b-a3b-instruct
NIM_API_KEY=         # build.nvidia.com 키 — 커밋 금지
