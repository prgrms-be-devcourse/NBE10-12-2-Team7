# EC2 #1 (app) 배포용. 실제 값은 .env 로 복사(gitignore). 이 파일은 키 목록.
# --- ECR ---
ECR_REGISTRY=<AWS계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com
IMAGE_TAG=latest
# --- RDS (MySQL) ---
DB_URL=jdbc:mysql://<rds-endpoint>:3306/dongne_market?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=dongne
DB_PASSWORD=changeme
# --- App ---
JWT_SECRET=please-change-to-a-long-random-secret-string
# --- AI (Ollama) ---
OLLAMA_BASE_URL=http://<ollama-접근가능주소>:11434
OLLAMA_MODEL=qwen3:14b
